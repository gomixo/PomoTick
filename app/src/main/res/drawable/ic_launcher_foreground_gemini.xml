<?xml version="1.0" encoding="utf-8"?>
<!--
  PomoTick adaptive icon foreground.
  viewport 与原 SVG 同坐标系 (512x512)；系统渲染至 108dp 物理尺寸。
  像素内容总宽 220 / 512 * 108 ≈ 46.4dp；总高 70 / 512 * 108 ≈ 14.77dp。
  文字居中于 (256, 256) 即物理 54dp，完全位于 66dp safe zone 圆内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!--
        黑色像素括号 [...] —— 6 个 10x10/20x10 矩形组合：
        左括号：竖 (146,221,10,70) + 顶 (156,221,20,10) + 底 (156,281,20,10)
        右括号：竖 (356,221,10,70) + 顶 (336,221,20,10) + 底 (336,281,20,10)
        模板：每个子路径用 M x,y  h w  v h  h -w  z 描述矩形
    -->
    <path
        android:fillColor="#000000"
        android:pathData="
            M146,221 h10 v70 h-10 z
            M156,221 h20 v10 h-20 z
            M156,281 h20 v10 h-20 z
            M336,221 h20 v10 h-20 z
            M336,281 h20 v10 h-20 z
            M356,221 h10 v70 h-10 z
        " />

    <!--
        灰色像素字母 —— 10 个矩形组成 2 个 S 形字模：
        字 1 (x:196~246)：
          顶横 (196,221,50,10)
          右上竖 (236,231,10,20)
          中横 (196,251,50,10)
          左下竖 (196,261,10,20)
          底横 (196,281,50,10)
        字 2 (x:266~316)：镜像同上
          顶横 (266,221,50,10)
          左上竖 (266,231,10,20)
          中横 (266,251,50,10)
          右下竖 (306,261,10,20)
          底横 (266,281,50,10)
    -->
    <path
        android:fillColor="#E5E5E5"
        android:pathData="
            M196,221 h50 v10 h-50 z
            M236,231 h10 v20 h-10 z
            M196,251 h50 v10 h-50 z
            M196,261 h10 v20 h-10 z
            M196,281 h50 v10 h-50 z
            M266,221 h50 v10 h-50 z
            M266,231 h10 v20 h-10 z
            M266,251 h50 v10 h-50 z
            M306,261 h10 v20 h-10 z
            M266,281 h50 v10 h-50 z
        " />
</vector>